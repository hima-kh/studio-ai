{
  "name": "studio-ai",
  "version": "1.0.0",
  "description": "Production Studio AI - Photo to Video, Photo to Photo, 1080p+ video generation",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "setup": "bash setup.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "multer": "^1.4.5",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "socket.io": "^4.7.0",
    "pg": "^8.11.2",
    "redis": "^4.6.0",
    "uuid": "^9.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  }
}
